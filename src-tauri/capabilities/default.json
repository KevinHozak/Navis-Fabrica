{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window access to saved settings and bounded project discovery events.",
  "windows": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-discover-workflow-skills",
    "allow-save-settings",
    "allow-start-project-scan",
    "allow-cancel-project-scan",
    "allow-inspect-providers",
    "allow-get-cached-github-activity",
    "allow-refresh-github-activity",
    "allow-list-github-issues",
    "allow-get-github-issue",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
