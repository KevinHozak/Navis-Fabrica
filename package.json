{
  "name": "navis-fabrica",
  "private": true,
  "version": "0.26.12",
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "24.14.x",
    "npm": "11.11.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:check": "npm run build:worker && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:build": "tauri build",
    "build:worker": "node scripts/build-worker.mjs",
    "build:worker:release": "node scripts/build-worker.mjs --release",
    "release:verify": "node scripts/verify-release.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
