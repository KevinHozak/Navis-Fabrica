{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window access to saved settings, cached project inventory, and bounded project discovery events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-usage-dashboard",
    "allow-get-usage-dashboard-config",
    "allow-save-usage-dashboard-config",
    "allow-get-settings",
    "allow-runner-core-execute",
    "allow-get-runner-context",
    "allow-prepare-issue-work",
    "allow-discover-workflow-skills",
    "allow-save-settings",
    "allow-save-project-display-preferences",
    "allow-start-project-scan",
    "allow-start-affected-project-refresh",
    "allow-cancel-project-scan",
    "allow-inspect-providers",
    "allow-probe-antigravity-cli",
    "allow-probe-ollama",
    "allow-save-openrouter-credential",
    "allow-probe-openrouter",
    "allow-save-typesafe-credential",
    "allow-probe-typesafe",
    "allow-start-openrouter-workflow-run",
    "allow-create-provider-handoff",
    "allow-start-ollama-workflow-run",
    "allow-start-codex-workflow-run",
    "allow-start-reviewed-git-run",
    "allow-start-script-build-run",
    "allow-start-antigravity-workflow-run",
    "allow-get-cached-github-activity",
    "allow-refresh-github-activity",
    "allow-list-github-issues",
    "allow-get-github-issue",
    "allow-list-workflow-runs",
    "allow-export-workflow-diagnostics",
    "allow-delete-finished-workflow-runs",
    "allow-start-workflow-run",
    "allow-cancel-workflow-run",
    "allow-mark-workflow-run-needs-input",
    "allow-write-workflow-run-input",
    "allow-respond-codex-approval",
    "allow-respond-codex-user-input",
    "allow-list-usage-signals",
    "allow-list-jev-routing-history",
    "allow-record-manual-usage-estimate",
    "allow-evaluate-routing",
    "allow-evaluate-jev-routing",
    "allow-evaluate-provider-fallback",
    "allow-calibrate-routing",
    "allow-get-project-inventory",
    "allow-get-project-commit-draft-context",
    "allow-get-project-commit-changed-paths",
    "allow-prepare-project-commit-review",
    "allow-draft-project-commit-message",
    "allow-get-project-icon",
    "allow-run-project-git-action",
    "allow-list-project-branches",
    "allow-open-project-folder",
    "allow-open-project-github",
    "allow-get-release-executable-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
